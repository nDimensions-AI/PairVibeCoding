# Face Attendance System - Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Supabase Configuration
# ===================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# ===================
# Application Settings
# ===================
DEBUG=false
APP_NAME="Face Attendance System"

# ===================
# Face Recognition Settings
# ===================
# Minimum confidence for face detection (0-1)
FACE_DETECTION_CONFIDENCE=0.7

# Cosine similarity threshold for face matching (0-1)
# Higher = stricter matching, fewer false positives
FACE_RECOGNITION_THRESHOLD=0.45

# Liveness detection threshold (0-1)
LIVENESS_THRESHOLD=0.5

# ===================
# API Configuration (for frontend)
# ===================
API_URL=http://localhost:8000/api/v1
